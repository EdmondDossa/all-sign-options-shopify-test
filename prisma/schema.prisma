generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id             String             @id
  shop           String
  state          String
  isOnline       Boolean            @default(false)
  scope          String?
  expires        DateTime?
  accessToken    String
  userId         BigInt?
  isInitialized  Boolean            @default(false)
  accountOwner   Boolean            @default(false)
  collaborator   Boolean?           @default(false)
  email          String?
  emailVerified  Boolean?           @default(false)
  firstName      String?
  lastName       String?
  locale         String?
  categories     Category[]
  clipartsGroup  ClipartsGroup[]
  configurations Configuration[]
  Design         Design[]
  fonts          Font[]
  setting        Setting?
  purchasedPacks ShopTemplatePack[]
  templates      Template[]
}

model Upload {
  id    Int    @id @default(autoincrement())
  files Json?
  shop  String @unique
}

model Configuration {
  id           Int        @id @default(autoincrement())
  name         String
  description  String?
  icon         String
  popupImg     String
  sessionId    String
  data         Json?
  product      Json?
  materialType String?
  productType  String?
  session      Session    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  templates    Template[]
}

model Font {
  id           Int     @id @default(autoincrement())
  label        String
  url          String
  isGoogleFont Boolean
  sessionId    String
  session      Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model ClipartsGroup {
  id          Int       @id @default(autoincrement())
  title       String
  description String
  sessionId   String
  cliparts    Clipart[]
  session     Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model Clipart {
  id              Int           @id @default(autoincrement())
  title           String
  url             String
  additionalPrice Float
  clipartsGroupId Int
  clipartsGroup   ClipartsGroup @relation(fields: [clipartsGroupId], references: [id], onDelete: Cascade)
}

model Setting {
  id        Int     @id @default(autoincrement())
  data      Json?
  sessionId String  @unique
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model Category {
  id        Int        @id @default(autoincrement())
  name      String
  sessionId String
  session   Session    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  templates Template[]
}

model Template {
  id                   Int           @id @default(autoincrement())
  name                 String
  basePrice            Float
  configurationId      Int
  categoryId           Int?
  sessionId            String
  data                 Json?
  enabledAddToCart     Boolean       @default(false)
  prevImg              String
  recaps               Json?
  enabledAutoImgUpdate Boolean       @default(false)
  realImg              String?
  category             Category?     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  configuration        Configuration @relation(fields: [configurationId], references: [id], onDelete: Cascade)
  session              Session       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model Design {
  id         Int     @id @default(autoincrement())
  sessionId  String
  customerIp String?
  orderId    String?
  productId  String?
  configId   Int?
  variantId  String?
  fileName   String?
  fileSize   Int?
  fileType   String?
  fileUrl    String?
  storage    String?
  zipFile    Json?
  session    Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model TemplatePack {
  id          Int                @id @default(autoincrement())
  name        String
  slug        String             @unique
  description String?
  category    String
  price       Float
  jsonFile    String
  previewImg  String
  icon        String?
  isActive    Boolean            @default(true)
  order       Int                @default(0)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  purchases   ShopTemplatePack[]

  @@index([slug])
  @@index([isActive])
}

model ShopTemplatePack {
  id              Int          @id @default(autoincrement())
  sessionId       String
  packId          Int
  purchasedAt     DateTime     @default(now())
  purchasePrice   Float
  isActive        Boolean      @default(true)
  purchaseStatus  String?
  shopifyChargeId String?
  pack            TemplatePack @relation(fields: [packId], references: [id], onDelete: Cascade)
  session         Session      @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, packId])
  @@index([sessionId])
  @@index([packId])
}
