// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model Session {
  id          String    @id
  shop        String
  state       String
  isOnline    Boolean   @default(false)
  scope       String?
  expires     DateTime?
  accessToken String
  userId      BigInt?
  configurations  Configuration[]
  fonts       Font[]
  sizes       Size[]
  colors      Color[]
  clipartsGroup   ClipartsGroup[]
  setting    Setting?
}

model Upload{
  id          Int    @id @default(autoincrement())
  files       Json? 
  shop        String @unique 
} 


model Configuration {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  icon        String
  popupImg    String
  session     Session @relation(fields: [sessionId], references: [id])
  sessionId   String
  data        Json?
}

model Size {
  id          Int      @id @default(autoincrement())
  label       String?
  width       Int 
  height      Int
  thickness   Json
  session     Session @relation(fields: [sessionId], references: [id])
  sessionId   String
}

model Font {
  id            Int      @id @default(autoincrement())
  label         String
  url           String
  isGoogleFont  Boolean
  session     Session @relation(fields: [sessionId], references: [id])
  sessionId   String
}

model Color{
  id            Int      @id @default(autoincrement())
  name              String
  textColor         String
  backgroundColor   String
  session     Session @relation(fields: [sessionId], references: [id])
  sessionId   String
}

model ClipartsGroup{
  id            Int      @id @default(autoincrement())
  title         String
  description   String
  cliparts      Clipart[] 
  session     Session @relation(fields: [sessionId], references: [id])
  sessionId   String
}


model Clipart{
    id                Int      @id @default(autoincrement())
    title             String
    url               String
    additionalPrice   Float
    clipartsGroup     ClipartsGroup @relation(fields: [clipartsGroupId], references: [id])
    clipartsGroupId   Int 
}

model Setting{
  id          Int      @id @default(autoincrement())
  data        Json?      
  session     Session   @relation(fields: [sessionId], references: [id])
  sessionId   String @unique
}

