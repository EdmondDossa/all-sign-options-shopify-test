// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model Session {
  id          String    @id
  shop        String
  state       String
  isOnline    Boolean   @default(false)
  scope       String?
  expires     DateTime?
  accessToken String
  userId      BigInt?
  isInitialized    Boolean   @default(false)
  configurations  Configuration[]
  fonts       Font[]
  clipartsGroup   ClipartsGroup[]
  templates      Template[] 
  categories      Category[] 
  setting    Setting?
  Design    Design[]
}

model Upload{
  id          Int    @id @default(autoincrement())
  files       Json? 
  shop        String @unique 
} 


model Configuration {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  icon        String
  popupImg    String
  session     Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId   String
  data        Json?
  product     Json?
  templates      Template[] 
}



model Font {
  id            Int      @id @default(autoincrement())
  label         String
  url           String
  isGoogleFont  Boolean
  session     Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId   String
}



model ClipartsGroup{
  id            Int      @id @default(autoincrement())
  title         String
  description   String
  cliparts      Clipart[] 
  session     Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId   String
}


model Clipart{
    id                Int      @id @default(autoincrement())
    title             String
    url               String
    additionalPrice   Float
    clipartsGroup     ClipartsGroup @relation(fields: [clipartsGroupId], references: [id], onDelete: Cascade)
    clipartsGroupId   Int 
}

model Setting{
  id          Int      @id @default(autoincrement())
  data        Json?      
  session     Session   @relation(fields: [sessionId], references: [id],onDelete: Cascade)
  sessionId   String @unique
}


model Category{
  id            Int      @id @default(autoincrement())
  name         String
  templates      Template[] 
  session     Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId   String
}


model Template {
  id                Int      @id @default(autoincrement())
  name              String
  basePrice         Float
  prevImg           String
  realImg           String?
  recaps             Json?
  enabledAddToCart  Boolean  @default(false)
  enabledAutoImgUpdate  Boolean  @default(false)
  configuration     Configuration @relation(fields: [configurationId], references: [id], onDelete: Cascade)
  configurationId   Int
  category          Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade )
  categoryId        Int?
  session           Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId         String
  data            Json?
}


model Design {
  id          Int      @id @default(autoincrement())
  customerIp  String?
  productId   String?
  configId    Int?
  variantId   String?
  orderId     String?
  session           Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId         String
  files       Json?
  zipFile  String?
}

