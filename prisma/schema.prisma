// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model Session {
  id          String    @id
  shop        String
  state       String
  isOnline    Boolean   @default(false)
  scope       String?
  expires     DateTime?
  accessToken String
  userId      BigInt?
  configurations  Configuration[]
}

model Upload{
  id          Int    @id @default(autoincrement())
  files       Json? 
  shop        String @unique 
} 


model Configuration {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  icon        String
  popupImg    String
  session     Session @relation(fields: [sessionId], references: [id])
  sessionId   String
  data        Json?
}
