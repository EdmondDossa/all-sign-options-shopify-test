{% assign asoProduct = block.settings.product %}
{% assign asoConfigurationId = asoProduct.metafields.allSignsOptionsAsoAso.asoConfigurationId.value  %}
{% assign asoProductId = asoProduct.id  %}
{% assign asoScriptLoad = true  %}

<script>
  var asoConfigurationId = "{{asoConfigurationId}}";
  var asoProductId = "{{asoProductId}}";
  var asoCurrency = "{{cart.currency.symbol}}";
  
  var asoPriceFormat ="{{shop.money_format}}";
  var asoRegularPrice ="{{ asoProduct.price | money_without_currency }}";
  var asoFormattedPrice ="{{ 123456| money_without_currency }}";
  var asoCurrency_pos= asoPriceFormat[0] == asoCurrency? "left": "right";
  var asoThousandSep= asoFormattedPrice[1]=="2"?"":asoFormattedPrice[1];
  var asoDecimalSep= asoFormattedPrice[4]=="5"?".":asoFormattedPrice[4];
  var asoCartUrl = "{{ routes.cart_url }}";
  {% if asoConfigurationId == null or asoConfigurationId == "" %}
    {% if request.design_mode == false %}
    if(!(new URLSearchParams(window.location.search)).get('aso-template-id')){
    
      document.write('<style>.shopify-app-wrapper{display: none !important;}<\/style>');
    }
   {% endif %} 
  {% endif %}
</script>

<link rel="stylesheet" crossorigin href="{{'index.css' |asset_url }}">
<script src="{{'shopify.js'|asset_url}}"></script>
