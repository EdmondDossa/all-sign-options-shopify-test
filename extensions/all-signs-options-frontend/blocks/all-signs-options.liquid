{% render 'pricing-format' %}
{% render 'notyf' %}

{% assign aso_product = product %}
{% assign aso_configuration_id = aso_product.metafields.allSignsOptionsAsoAso.asoConfigurationId.value  %}
{% assign aso_product_id = aso_product.id  %}
<script>
  var asoConfigurationId = "{{ aso_configuration_id }}";
  var asoProductId = "{{ aso_product_id }}";
  var asoRegularPrice ="{{ aso_product.price | money_without_currency }}";

  {% if aso_configuration_id == null or aso_configuration_id == "" %}
    {% if request.design_mode == false %}
    if(!(new URLSearchParams(window.location.search)).get('aso-template-id')){
    
      document.write('<style>.shopify-app-wrapper{display: none !important;}<\/style>');
    }
   {% endif %} 
  {% endif %}
</script>

{% if block.settings.useModal %}
  <!-- Boutons pour ouvrir les modals -->
  <div class="aso-modal-buttons-container">
    {% if block.settings.design_button_enabled and aso_configuration_id %}
      <button id="asoDesignBtn" class="aso-modal-button aso-design-button" type="button" 
              style="background-color: {{ block.settings.design_button_color }}; color: {{ block.settings.design_button_text_color }};">
        <span class="aso-btn-spinner" aria-hidden="true"></span>
        <span class="aso-btn-text">{{ block.settings.design_button_text | default: "Design from blank" }}</span>
      </button>
    {% endif %}
    {% if  block.settings.upload_button_enabled %}
      <button id="asoUploadBtn" class="aso-modal-button aso-upload-button" type="button" 
              style="background-color: {{ block.settings.upload_button_color }}; color: {{ block.settings.upload_button_text_color }};">
        {{ block.settings.upload_button_text | default: "Upload your Sign" }}
      </button>
    {% endif %}
    {% if block.settings.view_uploads_button_enabled %}
      <button id="asoViewUploadsBtn" class="aso-modal-button aso-view-uploads-button" type="button" 
              style="background-color: {{ block.settings.view_uploads_button_color }}; color: {{ block.settings.view_uploads_button_text_color }};">
        {{ block.settings.view_uploads_button_text | default: "View Uploaded Files" }}
      </button>
    {% endif %}
  </div>

  <!-- Modal pour le configurateur -->
  <div id="aso-design-modal" class="aso-modal" style="display: none;"> 
    <div class="aso-modal-content">
      <div class="aso-modal-header">
        <h2></h2>
        <button class="aso-modal-close" onclick="closeDesignModal()">&times;</button>
      </div>
      <div class="aso-modal-body">
        <div class="shopify-app-wrapper"  >
          <div class="aso-app" id="app">
            {% render 'loader' %}
          </div>
          <div class='aso-app-not-found'>
            <div class="aso-app-not-found-item">
              No design configuration has been found.
              Please select a product assigned to a valid design configuration for this block.
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Modal pour l'upload -->
  {% render 'uploads-modal' %}

  <!-- Modal pour voir les fichiers uploadés -->
  {% render 'view-uploads-modal' %}
{% else %}
  <div class="shopify-app-wrapper"  >
    <div class="aso-app" id="app">
      {% render 'loader' %}
    </div>
    <div class='aso-app-not-found'>
      <div class="aso-app-not-found-item">
        No design configuration has been found.
        Please select a product assigned to a valid design configuration for this block.
      </div>
    </div>
  </div>
{% endif %}


{% render 'style' %}

<!-- Affichage normal du configurateur -->
{% if block.settings.useIframe == false %}
  <link rel="stylesheet"  href="{{'index.css' |asset_url }}">
  <script src="{{'shopify.js'|asset_url}}" defer></script>
  <script src="{{'fabric.min.js'|asset_url}}" defer></script>
  <script id="design-js" type="module"  src="{{'index.js' |asset_url }}"></script>

{% else %} 

  <script>
    const iframeBaseUrl = '/apps/aso-proxy/assets-preview/aso-iframe.html';
    const iframeUrl = `${iframeBaseUrl}?asoProductId=${encodeURIComponent(asoProductId)}&asoCurrency=${encodeURIComponent(asoCurrency)}&asoPriceFormat=${encodeURIComponent(asoPriceFormat)}&asoRegularPrice=${encodeURIComponent(asoRegularPrice)}&asoCurrency_pos=${encodeURIComponent(asoCurrency_pos)}&asoThousandSep=${encodeURIComponent(asoThousandSep)}&asoDecimalSep=${encodeURIComponent(asoDecimalSep)}&asoConfigurationId=${encodeURIComponent(asoConfigurationId)}`;

    function createIframe(targetDiv, forceReload) {
      const iframe = document.createElement('iframe');
      iframe.src = forceReload ? iframeUrl + '&_t=' + Date.now() : iframeUrl;
      iframe.width = '100%';
      iframe.height = '100%';
      iframe.style.border = 'none';
      iframe.setAttribute('name', 'ASOIframe');

      if (targetDiv) {
        targetDiv.innerHTML = '';
        targetDiv.appendChild(iframe);
      }
    }

    // Créer l'iframe pour l'affichage direct (quand useModal est false)
    {% if block.settings.useModal == false %}
      const targetDiv = document.querySelector('.aso-app');
      createIframe(targetDiv);
    {% endif %}

    // Fonction pour créer l'iframe dans le modal (quand useModal est true)
    // forceReload=true : évite le cache pour charger le bon contenu (template ou config produit)
    window.createIframeInModal = function(forceReload) {
      const modalTargetDiv = document.querySelector('#aso-design-modal .aso-app');
      createIframe(modalTargetDiv, forceReload);
    };
        
  </script>

{% endif %}

{% if block.settings.useModal %}
<script>
  document.addEventListener('DOMContentLoaded', function() {
      const modals = document.querySelectorAll('.aso-modal');
      modals.forEach(function(modal) {
          modal.remove();
          document.body.appendChild(modal);
      });
      {% if block.settings.useIframe %}
      // Préchargement du configurateur pour un chargement plus rapide à l'ouverture
      if (window.createIframeInModal) {
        window.createIframeInModal(false);
      }
      {% endif %}
  });
</script>
{% endif %}


<script>
  // Fonctions pour les modals
  function openDesignModal() {
    {% if block.settings.useIframe %}
    // Toujours recréer l'iframe à l'ouverture pour afficher le bon contenu : template si aso-template-id dans l'URL, config produit sinon
    if (window.createIframeInModal) {
      window.createIframeInModal(true);
    }
    {% endif %}
    document.getElementById('aso-design-modal').style.display = 'block';
    document.body.style.overflow = 'hidden';
    document.body.classList.add('aso-modal-open');
    window.dispatchEvent(new Event('resize'));
  }

  function closeDesignModal() {
    document.getElementById('aso-design-modal').style.display = 'none';
    document.body.style.overflow = 'auto';
    document.body.classList.remove('aso-modal-open');
    lockProductForm(false);
    // Retirer aso-template-id et aso-config-id de l'URL pour que "Design from blank" rouvre le configurateur avec la config produit, pas le template
    try {
      var url = new URL(window.location.href);
      if (url.searchParams.has('aso-template-id') || url.searchParams.has('aso-config-id')) {
        url.searchParams.delete('aso-template-id');
        url.searchParams.delete('aso-config-id');
        history.replaceState(null, '', url.pathname + url.search);
      }
    } catch (e) {}
  }

  function closeUploadModal() {
    document.getElementById('aso-upload-modal').style.display = 'none';
    document.body.style.overflow = 'auto';
    document.body.classList.remove('aso-modal-open');
    lockProductForm(false);
  }

  function closeViewUploadsModal() {
    document.getElementById('aso-view-uploads-modal').style.display = 'none';
    document.body.style.overflow = 'auto';
    document.body.classList.remove('aso-modal-open');
    lockProductForm(false);
  }

  // Fonction pour désactiver/activer les boutons d'ajout au panier
  function lockProductForm(lock = true) {
    const productForm = document.querySelector('form[action="/cart/add"]');
    if (!productForm) return;
    productForm.querySelectorAll('button[type="submit"], input[type="submit"]').forEach(b => {
      b.disabled = lock;
    });
  }

  // Fermer les modals en cliquant à l'extérieur
  window.addEventListener('click', function(event) {
    const designModal = document.getElementById('aso-design-modal');
    const uploadModal = document.getElementById('aso-upload-modal');
    const viewUploadsModal = document.getElementById('aso-view-uploads-modal');
    
    if (event.target === designModal) {
      closeDesignModal();
    }
    if (event.target === uploadModal) {
      closeUploadModal();
    }
    if (event.target === viewUploadsModal) {
      closeViewUploadsModal();
    }
  });

  // Event listeners pour les boutons avec protection
  document.addEventListener('DOMContentLoaded', function() {
    // Récupérer le form d'ajout au panier
    const productForm = document.querySelector('form[action="/cart/add"]');

    // Ouvrir automatiquement le modal si aso-template-id est présent dans l'URL
    const urlParams = new URLSearchParams(window.location.search);
    const asoTemplateId = urlParams.get('aso-template-id');
    const designModal = document.getElementById('aso-design-modal');
    if (asoTemplateId && designModal) {
      setTimeout(function() {
        lockProductForm(true);
        openDesignModal();
      }, 500);
    }

    // Binder proprement les boutons - Design from blank avec loader 3 sec
    const DESIGN_BTN_DELAY_MS = 3000;
    document.getElementById('asoDesignBtn')?.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      const btn = e.currentTarget;
      if (btn.disabled || btn.classList.contains('aso-design-btn-loading')) return;
      try {
        var url = new URL(window.location.href);
        if (url.searchParams.has('aso-template-id') || url.searchParams.has('aso-config-id')) {
          url.searchParams.delete('aso-template-id');
          url.searchParams.delete('aso-config-id');
          history.replaceState(null, '', url.pathname + url.search);
        }
      } catch (err) {}
      btn.classList.add('aso-design-btn-loading');
      btn.disabled = true;
      lockProductForm(true);
      setTimeout(function() {
        btn.classList.remove('aso-design-btn-loading');
        btn.disabled = false;
        openDesignModal();
      }, DESIGN_BTN_DELAY_MS);
    });

    document.getElementById('asoUploadBtn')?.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      lockProductForm(true);
      document.getElementById('aso-upload-modal').style.display = 'block';
      document.body.style.overflow = 'hidden';
      document.body.classList.add('aso-modal-open');
    });

    document.getElementById('asoViewUploadsBtn')?.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      lockProductForm(true);
      if (typeof openViewUploadsModal === 'function') {
        openViewUploadsModal();
      } else {
        document.getElementById('aso-view-uploads-modal').style.display = 'flex';
        document.body.style.overflow = 'hidden';
        document.body.classList.add('aso-modal-open');
        if (typeof loadUploadedFiles === 'function') loadUploadedFiles();
      }
    });

    // 1 Bloque toute tentative de submit quand une modale ASO est ouverte
    productForm?.addEventListener('submit', (e) => {
      if (document.body.classList.contains('aso-modal-open')) {
        e.preventDefault();
        e.stopImmediatePropagation();
        console.warn('[ASO] Submit bloqué pendant la modale.');
      }
    });

    // 2 Par sécurité, on annule tout "submit" déclenché depuis notre container de boutons
    productForm?.addEventListener('click', (e) => {
      if (e.target.closest('.aso-modal-buttons-container')) {
        // Empêche qu'un autre script interprète le clic comme un add-to-cart
        e.preventDefault();
        e.stopImmediatePropagation();
      }
    }, true); // capture: intercepte avant d'autres listeners
  });

  // Fonction globale pour fermer les modales (utilisée par d'autres scripts)
  window.asoCloseModal = function () {
    document.body.classList.remove('aso-modal-open');
    lockProductForm(false);
    closeDesignModal();
    closeUploadModal();
    closeViewUploadsModal();
  };

  // Fonction globale pour créer une variante et l'ajouter au panier
  window.asoCreateVariantAndAddToCart = async function(price, option, asoProductID=asoProductId, regularPrice=asoRegularPrice, redirectToCheckOut=false) {
    try {
      console.log('[ASO] asoCreateVariantAndAddToCart called with:', { price, option, asoProductID, regularPrice, redirectToCheckOut });
      
      // Vérifier que l'option est définie
      if (!option || typeof option !== 'object') {
        console.error('[ASO] Invalid option data:', option);
        throw new Error('Invalid option data');
      }
      
      if (option.uploadFileOnFinish) {
        console.log('[ASO] Upload file on finish detected, returning null');
        // Gérer l'upload de fichier
        return null;
      }

      // Vérifier et corriger le prix
      let calculatedPrice = parseFloat(`${price}`) + parseFloat(`${regularPrice}`);
      if (!isFinite(calculatedPrice) || calculatedPrice < 0) {
        console.error('[ASO] Invalid price calculation:', { price, regularPrice, calculatedPrice });
        console.log('[ASO] Using fallback price calculation');
        
        // Utiliser un prix par défaut basé sur le prix régulier
        const fallbackPrice = parseFloat(`${regularPrice}`) || 0;
        calculatedPrice = fallbackPrice + (fallbackPrice * 0.1); // Ajouter 10% comme marge
        console.log('[ASO] Fallback price set to:', calculatedPrice);
      }

      const data = {
        productId: `gid://shopify/Product/${asoProductID}`,
        price: calculatedPrice,
        option: JSON.stringify(option)
      };
      
      console.log('[ASO] Making API call to /apps/aso-proxy/api/add-cart-variant');
      console.log('[ASO] Request data:', data);
      
      let response = await fetch((window.Shopify?.routes?.root || '/') + 'apps/aso-proxy/api/add-cart-variant', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify(data)
      });
    
      console.log('[ASO] API response status:', response.status);
      
      if (!response.ok) {
        throw new Error(`API request failed with status: ${response.status}`);
      }
      
      let responseData = await response.json();
      console.log('[ASO] API response data:', responseData);   

      // Vérifier si l'API a retourné une erreur
      if (responseData.status === false) {
        console.error('[ASO] API returned error:', responseData);
        throw new Error(`API error: ${responseData.message || 'Unknown error'}`);
      }

      // Vérifier que la réponse contient bien un variantId
      if (!responseData || !responseData.variantId) {
        console.error('[ASO] Invalid API response - missing variantId:', responseData);
        throw new Error('Invalid API response - missing variantId');
      }

      if (redirectToCheckOut) {
        console.log('[ASO] Redirecting to checkout:', `${window.location.origin}/cart/${responseData.variantId}:1`);
        document.location = window.location.origin + `/cart/${responseData.variantId}:1`;
      } else {
        console.log('[ASO] Redirecting to cart:', `${window.location.origin}/cart/${responseData.variantId}:1?storefront=true`);
        document.location = window.location.origin + `/cart/${responseData.variantId}:1?storefront=true`;
      }
    } catch (error) {
      console.error('[ASO] Error in asoCreateVariantAndAddToCart:', error);
      
      // En cas d'erreur, essayer d'ajouter le produit de base au panier
      console.log('[ASO] Fallback: trying to add base product to cart');
      try {
        const fallbackData = {
          'items': [{
            'id': asoProductID,
            'quantity': 1
          }]
        };
        
        let fallbackResponse = await fetch(window.Shopify.routes.root + 'cart/add.js', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify(fallbackData)
        });
        
        if (fallbackResponse.ok) {
          console.log('[ASO] Fallback successful, redirecting to cart');
          document.location = window.location.origin + '/cart';
        } else {
          console.error('[ASO] Fallback also failed');
        }
      } catch (fallbackError) {
        console.error('[ASO] Fallback error:', fallbackError);
      }
    }
  };



  window.addEventListener('message', async function(event) {
      if (event.data && event.data.type === 'ADD_TO_CART_CHECKOUT') {
        const formData = event.data.payload;
        console.log('[ASO] ADD_TO_CART_CHECKOUT payload:', formData);
        
        if (formData.id && formData.id !== 'undefined') {
          const variantId = parseInt(String(formData.id).replace(/^gid:\/\/shopify\/ProductVariant\//, ''), 10) || formData.id;
          const quantity = parseInt(formData.quantity, 10) || 1;
          try {
            const root = (window.Shopify && window.Shopify.routes && window.Shopify.routes.root) || '/';
            const addRes = await fetch(root + 'cart/add.js', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ items: [{ id: variantId, quantity: quantity }] })
            });
            if (addRes.ok) {
              const cartRes = await fetch(root + 'cart.js');
              const cartData = cartRes.ok ? await cartRes.json() : null;
              const checkoutUrl = cartData && typeof getAsoCheckoutUrl === 'function' ? await getAsoCheckoutUrl(cartData.token) : null;
              if (checkoutUrl) {
                document.location = checkoutUrl;
              } else {
                document.location = window.location.origin + '/cart';
              }
            } else {
              document.location = window.location.origin + '/cart/' + variantId + ':' + quantity;
            }
          } catch (e) {
            document.location = window.location.origin + '/cart/' + variantId + ':' + quantity;
          }
          return;
        }
        if (formData.price != null && formData.option && window.asoCreateVariantAndAddToCart) {
          await window.asoCreateVariantAndAddToCart(formData.price, formData.option, formData.productId || asoProductId, formData.regularPrice || asoRegularPrice, true);
        }
      }

      if (event.data && event.data.type === 'ADD_TO_CART') {
        const formData = event.data.payload;
        console.log('[ASO] ADD_TO_CART payload:', formData);
        
        // Cas 1 : on a déjà un variantId (créé par l'iframe) → ajouter au panier via l'API puis rediriger
        if (formData.id && formData.id !== 'undefined') {
          const variantId = parseInt(String(formData.id).replace(/^gid:\/\/shopify\/ProductVariant\//, ''), 10) || formData.id;
          const quantity = parseInt(formData.quantity, 10) || 1;
          console.log('[ASO] Adding variant to cart via API:', { variantId, quantity });
          try {
            const root = (window.Shopify && window.Shopify.routes && window.Shopify.routes.root) || '/';
            const addRes = await fetch(root + 'cart/add.js', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ items: [{ id: variantId, quantity: quantity }] })
            });
            const addJson = await addRes.json().catch(function() { return null; });
            if (addRes.ok) {
              console.log('[ASO] Item added, redirecting to cart');
              document.location = window.location.origin + '/cart';
            } else {
              console.error('[ASO] Cart add failed:', addRes.status, addJson);
              document.location = window.location.origin + '/cart/' + variantId + ':' + quantity;
            }
          } catch (e) {
            console.error('[ASO] Cart add request failed:', e);
            document.location = window.location.origin + '/cart/' + variantId + ':' + quantity;
          }
          return;
        }
        
        // Cas 2 : on a price + option → créer la variante puis ajouter (asoCreateVariantAndAddToCart gère le postMessage)
        if (formData.price != null && formData.option && window.asoCreateVariantAndAddToCart) {
          console.log('[ASO] Calling asoCreateVariantAndAddToCart with checkout=false');
          await window.asoCreateVariantAndAddToCart(formData.price, formData.option, formData.productId || asoProductId, formData.regularPrice || asoRegularPrice, false);
          return;
        }
        
        console.warn('[ASO] ADD_TO_CART payload missing id or (price+option):', formData);
      }

      if (event.data && event.data.type ===  'UPLOAD_ON_FINISH') {
        const formData = event.data.payload;
        
        let ip ="";
        try {
            const response = await fetch('https://api.ipify.org?format=json');
            const dataIp = await response.json();
            ip = dataIp.ip;
        } catch (error) {
            console.error('Error fetching IP address:', error);
        } 

        function getFileInfoFromBase64(base64String) {
            // Extract MIME type from the Base64 string
            const mimeType = base64String.match(/^data:(.*?);base64,/)?.[1];
            
            // Get file extension (e.g., 'png', 'jpeg', 'pdf')
            const fileType = mimeType?.split('/')[1] || 'unknown';
            
            // Remove Base64 header to calculate raw data size
            const base64Data = base64String.replace(/^data:.*?;base64,/, '');
            
            // Calculate size in bytes (accounting for padding)
            const padding = base64Data.match(/=+$/)?.[0]?.length || 0;
            const sizeInBytes = (base64Data.length * 3) / 4 - padding;
            
            // Convert to KB (2 decimal places)
            const sizeInKB = (sizeInBytes / 1024).toFixed(2);
            
            return {
              name: `file_${Date.now()}.${fileType}`, // Example: "file_1712345678901.png"
              type: mimeType, // 'png', 'jpeg', 'pdf', etc.
              size: parseFloat(sizeInKB), // Size in KB (e.g., 25.42)
              data: base64String
            };
          }

       
        
        // Créer l'objet de données selon le schéma requis
        const requestData = {
          productId: asoProductId+'',
          configId: asoConfigurationId,
          variantId: '',
          customerIp: ip,
          files: JSON.stringify(JSON.parse(formData).map((file,index)=>({
            ...getFileInfoFromBase64(file),
            data: file
          })))
        }
         
        
        // Effectuer la requête POST avec JSON
        const response = await fetch('/apps/aso-proxy/api/uploads', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify(requestData)
        });
        
        if (response.ok) {
          const result = await response.json();
        
          // Fermer la modal après succès
          closeDesignModal();
          window.parent?.postMessage({ type: 'ASO_ENABLE_DESIGNS' }, '*')
          window.postMessage({ type: 'ASO_ENABLE_DESIGNS' }, '*')
          
          // Message de succès
          notyf.success(`Design uploaded successful!`);

         
          
          return result;
        } else {
          const errorData = await response.json();
          console.error('Upload error:', errorData);
        }
      }
  })
</script>



{% schema %} 
{
  "name": "All Signs Customizer",
  "target": "section",
  "settings": [
      {
        "type": "paragraph",
        "content": "Pour un affichage optimal, placez ce bloc après le bloc « Sélecteur de quantité » sur la page produit."
      },
      {
        "id": "useIframe",
        "type": "checkbox",
        "label": "Use iframe to show configuration",
        "default": true,
        "info": "Enable this if you experience template compatibility issues."
      },
      {
        "id": "useModal",
        "type": "checkbox",
        "label": "Use modal interface",
        "default": true,
        "info": "Enable this to show buttons that open modals instead of displaying the configurator directly."
      },
      {
        "type": "header",
        "content": "Design Button Settings"
      },
      {
        "id": "design_button_enabled",
        "type": "checkbox",
        "label": "Enable  Design Button",
        "default": true,
        "info": "This  option  allow to show the design button"
      },
      {
        "id": "design_button_text",
        "type": "text",
        "label": "Design Button Text",
        "default": "Design from blank"
      },
      {
        "id": "design_button_color",
        "type": "color",
        "label": "Design Button Background Color",
        "default": "#667eea"
      },
      {
        "id": "design_button_text_color",
        "type": "color",
        "label": "Design Button Text Color",
        "default": "#ffffff"
      },
      {
        "type": "header",
        "content": "Upload Button Settings"
      },
      {
        "id": "upload_button_enabled",
        "type": "checkbox",
        "label": "Enable  Upload Button",
        "default": false,
        "info": "This  option  allow to show the upload button"
      },
      {
        "id": "upload_button_text",
        "type": "text",
        "label": "Upload Button Text",
        "default": "Upload your Sign"
      },
      {
