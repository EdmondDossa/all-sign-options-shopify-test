{% schema %}
{
  "name": "All  signs options ",
  "target": "section",
  "settings": [
    {
      "id": "useIframe",
      "type": "checkbox",
      "label": "Use iframe to show configuration",
      "default": false,
      "info": "Enable this if you experience template compatibility issues."
    },
    { "type": "product", "id": "product", "label": "Product with configuration", "autofill": true, "info":"Select a product that has been assigned to a configuration, but on the product details page, the configuration of the current product is displayed only if  available" }
  ]
}
{% endschema %} 

