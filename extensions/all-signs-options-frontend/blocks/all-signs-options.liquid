{% assign asoProduct = block.settings.product %}
{% assign asoConfigurationId = asoProduct.metafields.allSignsOptionsAsoAso.asoConfigurationId.value  %}
{% assign asoProductId = asoProduct.id  %}
{% assign asoScriptLoad = true  %}

<script>
  var asoConfigurationId = "{{asoConfigurationId}}";
  var asoProductId = "{{asoProductId}}";
  var asoCurrency = "{{cart.currency.symbol}}";
  
  var asoPriceFormat ="{{shop.money_format}}";
  var asoRegularPrice ="{{ asoProduct.price | money_without_currency }}";
  var asoFormattedPrice ="{{ 123456| money_without_currency }}";
  var asoCurrency_pos= asoPriceFormat[0] == asoCurrency? "left": "right";
  var asoThousandSep= asoFormattedPrice[1]=="2"?"":asoFormattedPrice[1];
  var asoDecimalSep= asoFormattedPrice[4]=="5"?".":asoFormattedPrice[4];
  var asoCartUrl = "{{ routes.cart_url }}";

</script>

<link rel="stylesheet" crossorigin href="{{'index.css' |asset_url }}">
<script src="{{'shopify.js'|asset_url}}"></script>
<script src="{{'fabric.min.js'|asset_url}}"></script>
<script src="{{'editor.script.js'|asset_url }}"></script>
<script type="module" crossorigin src="{{'index.js' |asset_url }}"></script>

<div class="shopify-app-wrapper">
    <div class="aso-app" id="app">
      <h1> configuration Design  Screen </h1> 
    
      <div class="bg-loader">
        <div class="loader"> 
        </div> 
      </div>
   
    </div>
</div> 


<style>
  .aso-app p {
    margin-top: 0px !important;
    margin-bottom: 0px !important;
  }
  
  .no-scrollbar::-webkit-scrollbar {
    display: none;
    overflow: auto;
  }
  
  .aso-scrollBar::-webkit-scrollbar {
    width: 6px;
    height: 4px;
    overflow: scroll;
  }
  .aso-scrollBar::-webkit-scrollbar-thumb {
    background-color: #016464;
    border-radius: 20px;
  }
   
  .aso-base-animation{
    transition-property: all;
    transition-duration: 500ms;
  }
  .aso-full-center {
    justify-content: center !important;
    align-items: center !important;
    /* white-space: nowrap; */
  }
  
  .aso-option-buton{
    width: fit-content;
    height: 90%;
    display: flex;
    flex-direction: column;
  }

  .aso-app{
    height: 100vh;
    width: 100%;
  }
  .aso-app *:not(input):empty {
    display: flex !important;
  }
  .shopify-app-wrapper{
    margin: 2rem 0rem
  }

  .aso-app .aso-inputColor-hide {
    display: none;
  }

  .aso-app .aso-advanceModel-img{
    width: -webkit-fill-available;
    width: -moz-available; /* For Firefox */
    width: fill-available;
  }

  .aso-app .aso-inputImage {
    /* aso-text-md  */   
    display: flex !important;
    padding: 8px 14px 8px 14px !important;
    border-radius: 9999px !important;
    cursor: pointer !important;
  }


  
  {% if asoConfigurationId == null or asoConfigurationId == "" %}
    {% if request.design_mode == false %}
    .shopify-app-wrapper{
      display: none !important;
    }
    {% endif %}
  {% endif %}


  .bg-loader{
    background-image: url({{'img_rectangle_noir.png' |asset_url }});
    background-repeat: no-repeat;
    background-size: cover; 
    background-position: center; 
    width: 100%;
    height: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    flex-direction: column;
  }


.loader {
  width: 50px;
  aspect-ratio: 1;
  border-radius: 50%;
  background: 
    radial-gradient(farthest-side,#c0c0c0 94%,#0000) top/8px 8px no-repeat,
    conic-gradient(#0000 30%,#c0c0c0);
  -webkit-mask: radial-gradient(farthest-side,#0000 calc(100% - 8px),#000 0);
  animation: l13 1s infinite linear;
}
@keyframes l13{ 
  100%{transform: rotate(1turn)}
}


</style>
{% schema %}
{
  "name": "All  signs options ",
  "target": "section",
  "settings": [
    { "type": "product", "id": "product", "label": "product", "autofill": true }
  ]
}
{% endschema %} 

