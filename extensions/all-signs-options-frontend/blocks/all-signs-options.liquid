<style>
  .aso-app p {
    margin-top: 0px !important;
    margin-bottom: 0px !important;
  }
  
  .no-scrollbar::-webkit-scrollbar {
    display: none;
    overflow: auto;
  }
  
  .aso-scrollBar::-webkit-scrollbar {
    width: 6px;
    height: 4px;
    overflow: scroll;
  }
  .aso-scrollBar::-webkit-scrollbar-thumb {
    background-color: #016464;
    border-radius: 20px;
  }
   
  .aso-base-animation{
    transition-property: all;
    transition-duration: 500ms;
  }
  .aso-full-center {
    justify-content: center !important;
    align-items: center !important;
    /* white-space: nowrap; */
  }
  
  .aso-option-buton{
    width: fit-content;
    height: 90%;
    display: flex;
    flex-direction: column;
  }

  .aso-app{
    height: 100vh;
    width: 100%;
  }
  .aso-app *:not(input):empty {
    display: flex !important;
  }
  .shopify-app-wrapper{
    margin: 2rem 0rem
  }

  .aso-app .aso-inputColor-hide {
    display: none;
  }

  .aso-app .aso-advanceModel-img,.aso-app img.aso-w-auto{
    width: -webkit-fill-available;
    width: -moz-available; /* For Firefox */
    width: fill-available;
  }

  .aso-app .aso-inputImage {
    /* aso-text-md  */   
    display: flex !important;
    padding: 8px 14px 8px 14px !important;
    border-radius: 9999px !important;
    cursor: pointer !important;
  }

  .aso-app #aso-options-container{
   z-index: 2;
  }


  
 


  .bg-loader{
    background-image: url({{'img_rectangle_noir.png' |asset_url }});
    background-repeat: no-repeat;
    background-size: cover; 
    background-position: center; 
    width: 100%;
    height: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    flex-direction: column;
    position: relative;
  }


.loader {
  top:50%;
  left:50%;
  width: 50px;
  height:50px;
  aspect-ratio: 1;
  border-radius: 50%;
  background: 
    radial-gradient(farthest-side,#c0c0c0 94%,#0000) top/8px 8px no-repeat,
    conic-gradient(#0000 30%,#c0c0c0);
  -webkit-mask: radial-gradient(farthest-side,#0000 calc(100% - 8px),#000 0);
  animation: l13 1s infinite linear ;
}
@keyframes l13{ 
  100%{transform: rotate(1turn)}
}


#aso-configurator-loader .skeleton-loader:empty {
  
  display: block;
  background: linear-gradient(
      to right,
      rgba(255, 255, 255, 0),
      rgba(255, 255, 255, 0.5) 50%,
      rgba(255, 255, 255, 0) 80%
    ),
    lightgray;
  background-repeat: repeat-y;
  background-size: 50px 500px;
  background-position: 0 0;
  animation: shine 1s infinite;
  
}

@keyframes shine {
  to {
    background-position: 100% 0;
  }

  
}


#aso-configurator-loader{
  width: 100%;
}

#aso-configurator-loader,
#aso-templates-loader {
  @keyframes pulseGradient {
    0%,
    100% {
      background-size: 200% 100%;
      background-position: 200% 50%;
      opacity: 0.5; /* Plus transparent /
    }
    50% {
      background-size: 200% 100%;
      background-position: -100% 50%;
      opacity: 1; / Pleine visibilité */
    }
  }

  .aso-loader-container {
    animation: pulseGradient 1.5s ease infinite;
  }
}




</style>
