/* CSS for the image hover effect */
.aso-template-image-wrapper {
  position: relative;
  display: inline-block; /* or block, depending on your layout */
}

.asoTemplateItemImg, 
.asoTemplateItemRealImg {
  transition: opacity 0.6s ease;
  display: block; /* removes extra space under images */
  width: 100%; /* ensures both images match dimensions */
  height: 100%;
}

.asoTemplateItemRealImg {
  position: absolute;
  top: 0;
  left: 0;
  opacity: 0;
}

.aso-template-image-wrapper:hover .asoTemplateItemImg {
  opacity: 0;
}

.aso-template-image-wrapper:hover .asoTemplateItemRealImg {
  opacity: 1;
}

