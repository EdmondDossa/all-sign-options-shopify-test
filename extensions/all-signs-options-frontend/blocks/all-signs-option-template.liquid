
<div>
    <div id="asoTemplate" class="aso-template-container">
        <div class="asoTemplateItem">
            <div class="aso-template-image-container">
                <div class="aso-template-image-wrapper">
                    <img class=" asoTemplateItemImg " src="{{'img_rectangle_noir.png' |asset_url }}" alt="aso  template">
                </div>
            </div>
            <div class="aso-template-details-container">
                <h5 class="asoTemplateItemName"> template  name</h5>
                <div class="aso-template-size asoTemplateItemSize">  template size </div>
                <div><span class="asoTemplateItemPrice">Price</span> <span class="asoTemplateItemTextAfter">  after price</span> </div>
                <div class="asoTemplateItemBtnWrapper">
                    <button  class="asoTemplateItemAddToCart">
                      <svg class="notAddingTocart" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" height="12" width="12">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 0 0-3 3h15.75m-12.75-3h11.218c1.121-2.3 2.1-4.684 2.924-7.138a60.114 60.114 0 0 0-16.536-1.84M7.5 14.25 5.106 5.272M6 20.25a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Zm12.75 0a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Z" />
                      </svg>
                      <svg class="addingTocart" style="display: none;" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" viewBox="0 0 100 100" preserveAspectRatio="xMidYMid" height="12" width="12">
                          <circle cx="50" cy="50" r="32" stroke-width="8" stroke="currentColor" stroke-dasharray="50.26548245743669 50.26548245743669" fill="none" stroke-linecap="round">
                          <animateTransform attributeName="transform" type="rotate" repeatCount="indefinite" dur="1s" keyTimes="0;1" values="0 50 50;360 50 50"></animateTransform>
                          </circle>
                      </svg>

                        Add to cart
                    </button>
                    <a href="{{ block.settings.asoDesignPageUrl }}"  class="asoTemplateItemCustomize">
                      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" height="12" width="12">
                            <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L6.832 19.82a4.5 4.5 0 0 1-1.897 1.13l-2.685.8.8-2.685a4.5 4.5 0 0 1 1.13-1.897L16.863 4.487Zm0 0L19.5 7.125" />
                        </svg>
                        Customize
                    </a>
                </div>

            </div>
        </div>
    </div>
</div>
{% if asoScriptLoad != true %}
<script>

  var asoConfigurationId = "";
  var asoProductId = "";
  var asoCurrency = "{{cart.currency.symbol}}";
  
  var asoPriceFormat ="{{shop.money_format}}";
  var asoRegularPrice ="";
  var asoFormattedPrice ="{{ 123456| money_without_currency }}";
  var asoCurrency_pos= asoPriceFormat[0] == asoCurrency? "left": "right";
  var asoThousandSep= asoFormattedPrice[1]=="2"?"":asoFormattedPrice[1];
  var asoDecimalSep= asoFormattedPrice[4]=="5"?".":asoFormattedPrice[4];
  var asoCartUrl = "{{ routes.cart_url }}";
</script>
<script src="{{ 'shopify.js' | asset_url }}"></script>

{% endif %}
<script>

var aso_configuration_id = "{{ block.settings.aso_configuration_id }}";
var asoPriceFormatTemplate ="{{shop.money_format}}";


async function getAsotemplates() {
    
  
    try {
      const response = await fetch(`${shopifyProxyURL}templates`, {
        method: 'GET',
        headers: {
          'Content-Type': 'application/json',
        },
      });
  
      if (!response.ok) {
        throw new Error(`ASO Proxy configuration fetch failed with status: ${response.status}`);
      }
  
      const data = await response.json();
      return data;
    } catch (error) {
      console.error('Error fetching ASO Proxy configuration:', error);
      // Handle the error appropriately in your application (e.g., display an error message to the user)
      return null; // Or throw an error if necemmmssuhhh ssscurrentConfig.data.settings.theme.skin
    }
}

var asoTemplateData = []




document.addEventListener('DOMContentLoaded', function(){
    getAsotemplates().then(templates=>{
    const contentHtml ="";
    console.log("template dtata", templates)


    const templateDiv = document.querySelector('#asoTemplate');
    const templateItem = templateDiv.querySelector('.asoTemplateItem');

    // Créer un nouveau div pour contenir les éléments clonés
    const newContainer = document.createElement('div');

// Pour chaque élément dans templates
    templates.filter(template=>(aso_configuration_id=="0" || template.configurationId==aso_configuration_id ) ).forEach(template => {
        // Cloner l'élément template
        const clone = templateItem.cloneNode(true);
        if (templates?.length) {
          asoTemplateData.push(...templates)
        }
        // Mettre à jour le contenu des divs spécifiques
        if (template.prevImg){
            clone.querySelector('.asoTemplateItemImg').setAttribute('src',template.prevImg)
        }
        clone.querySelector('.asoTemplateItemName').textContent = template.name;
        clone.querySelector('.asoTemplateItemSize').textContent = (template.data?.templateData)?   
        template.data.templateData.sign.size.width + ' ' +template.data.templateData.sign.size.unit + ' x '+
        template.data.templateData.sign.size.height + ' ' +template.data.templateData.sign.size.unit: "0mm x 0mm";
        clone.querySelector('.asoTemplateItemPrice').textContent = asoPriceFormatTemplate.replace("{","").replace("{amount}}", (template?.data?.cartData?.custom_price ? template.data.cartData.custom_price + template.basePrice : template.basePrice));
        clone.querySelector('.asoTemplateItemTextAfter').textContent =(template?.data?.templateData) ? template.data.templateData.price.textAfter:'';
        const asoDesignPageUrl =  clone.querySelector('.asoTemplateItemCustomize').getAttribute('href');
        clone.querySelector('.asoTemplateItemCustomize').setAttribute("href", asoDesignPageUrl+(asoDesignPageUrl.includes("?")?"&":"?")+"aso-template-id="+template.id+"&aso-config-id=" +template.configurationId)
        clone.querySelector('.asoTemplateItemAddToCart').setAttribute('onclick',"addTemplateTocart("+template.id+")");
        clone.querySelector('.notAddingTocart').setAttribute('class',"notAddingTocart"+template.id);
        clone.querySelector('.addingTocart').setAttribute('class',"addingTocart"+template.id);
        if (template?.enableAddToCart) {
            clone.querySelector('.asoTemplateItemAddToCart').style.display = 'none';
        }

        
        // Ajouter le clone au nouveau conteneur
        newContainer.appendChild(clone);
    });

    // Remplacer le contenu de #asoTemplate par le nouveau contenu
    templateDiv.innerHTML = newContainer.innerHTML;

  
}).catch((error) =>{
  console.log(' error  on fetching template',error)
});
}); 



function addTemplateTocart(id){
  console.log("start  add to  cart");
  if (typeof addTemplateToCartShopify == "function") {
    //debut de gestion du loading
    let template = asoTemplateData.find(template=>(template.id == id) )
    console.log("template start  add  to  cart",template)
    const templateDiv = document.querySelector('#asoTemplate');
    templateDiv.querySelector('.notAddingTocart'+template.id).style.display = 'none';
    templateDiv.querySelector('.addingTocart'+template.id).style.display = 'block';
   
    //fin

    addTemplateToCartShopify(template).then(res=>{
      //debut de gestion du loading
      templateDiv.querySelector('.notAddingTocart'+template.id).style.display = 'block';
      templateDiv.querySelector('.addingTocart'+template.id).style.display = 'none';
      //fin
      console.log("end of  add to  cart");
    }).catch((err)=>{
      console.log("error on adding to cart", error);
    });
  }
}
</script>
<style>
.asoTemplateItemCustomize {
  color: white;
  display: flex;
  justify-content: center;
  align-items: center;
  background-color: #febd52;
  border-radius: 0.5rem;
  width: 100%;
  padding: 0.75rem;
