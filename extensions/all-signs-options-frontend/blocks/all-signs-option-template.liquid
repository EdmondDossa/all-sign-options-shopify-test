    background-color: #fcac29;
}


.asoTemplateItemAddToCart {
  display: flex;
  justify-content: center;
  align-items: center;
  background-color: #0374e3;
  border-radius: 5px;
  width: 100%;
  padding: 0.75rem;
}


.asoTemplateItemBtnWrapper{
  gap: 1rem;
  margin-block-start: 0rem;
  margin-block-end: 0rem;
  padding-block-start: 1rem;
  padding-block-end: 1rem;
  display: flex;
  flex-direction: column;
}


.asoTemplateItemPrice{
    font-weight: bold;
}

.asoTemplateItemName{
    font-weight: bold;
    margin-block-start: 0px;
    margin-block-end: 1rem;
}

.aso-template-details-container{
  border-width: 1px;
  border-style: solid;
  border-left: 0;
  border-bottom: 0;
  border-right: 0;
  border-color: #c3cfd6;
  padding: 1rem;

}

.asoTemplateItemImg{
      /* height: 150px; */
      width: 100%;
    object-fit: cover;
}

.aso-template-image-wrapper{
    width: 100%; /* aso-w-1/2 */
    height: 100%; /* aso-h-full */
    display: flex; /* aso-flex */
    justify-content: center; /* aso-justify-center */
    align-items: center; /* aso-items-center */
    overflow: clip;
    padding: 0px;
}

.aso-template-image-container {
    display: flex;
    justify-content: center;
    align-items: center;
    height: 150px; /* aso-h-[150px] */
    overflow: hidden;
}

.asoTemplateItem{
    border-width: 1px;
    border-style: solid;
    border-color: #c3cfd6;
    border-radius: 5px; /* aso-rounded */
    background-color: transparent; /* aso-bg-transparent */
    overflow: hidden;
}

.aso-template-container{
  display: grid;
  gap: 8px; /* aso-gap-8 */
}

@media (min-width: 1200px) {
  .aso-template-container {
    grid-template-columns: repeat(4, 1fr);
  }
}

@media (min-width: 992px) and (max-width: 1199px) {
  .aso-template-container {
    grid-template-columns: repeat(4, 1fr);
  }
}

@media (min-width: 600px) and (max-width: 991px) {
  .aso-template-container {
    grid-template-columns: repeat(3, 1fr);
  }
}

@media (max-width: 600px) {
  .aso-template-container {
    grid-template-columns: repeat(2, 1fr);
  }
}


@media (max-width: 400px) {
  .aso-template-container {
    grid-template-columns: 1fr;
  }
}
    
</style>

