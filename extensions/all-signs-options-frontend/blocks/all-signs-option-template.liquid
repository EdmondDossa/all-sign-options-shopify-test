{% if block.settings.use_modal_interface %}
<script>
  function openTemplatesModal() {
    var modal = document.getElementById('aso-templates-modal');
    if (modal) {
      modal.style.display = 'block';
      document.body.style.overflow = 'hidden';
      document.body.classList.add('aso-modal-open');
    }
  }
  function closeTemplatesModal() {
    var modal = document.getElementById('aso-templates-modal');
    if (modal) {
      modal.style.display = 'none';
      document.body.style.overflow = 'auto';
      document.body.classList.remove('aso-modal-open');
    }
    if (typeof lockProductForm === 'function') lockProductForm(false);
  }
  document.addEventListener('DOMContentLoaded', function() {
    var modal = document.getElementById('aso-templates-modal');
    if (modal) {
      modal.remove();
      document.body.appendChild(modal);
    }
    var btn = document.getElementById('asoOpenTemplatesModalBtn');
    if (btn) {
      btn.addEventListener('click', function(e) {
        e.preventDefault();
        if (typeof lockProductForm === 'function') lockProductForm(true);
        openTemplatesModal();
      });
    }
    document.addEventListener('click', function(ev) {
      if (ev.target && ev.target.id === 'aso-templates-modal') closeTemplatesModal();
    });
  });
</script>
{% endif %}



<script>

  var aso_configuration_id = "{{ block.settings.aso_configuration_id }}";
  var asoTemplateUseModal = {{ block.settings.use_modal_interface | json }};
  var asoPriceFormatTemplate ="{{shop.money_format}}";


  async function getAsotemplates() {
      var productId = "{{ product.id | default: '' }}";
      var url = `${window.Shopify.routes.root}apps/aso-proxy/api/templates`;
      if (productId) {
        url += '?productId=' + encodeURIComponent(productId);
      }
      try {
        const response = await fetch(url, {
          method: 'GET',
          headers: {
            'Content-Type': 'application/json',
          },
        });
    
        if (!response.ok) {
          throw new Error(`ASO Proxy configuration fetch failed with status: ${response.status}`);
        }
    
        const data = await response.json();
        return data;
      } catch (error) {
        console.error('Error fetching ASO Proxy configuration:', error);
        // Handle the error appropriately in your application (e.g., display an error message to the user)
        return null; // Or throw an error if necemmmssuhhh ssscurrentConfig.data.settings.theme.skin
      }
  }


  async function getAsoTemplate(id) {
      
    
      try {
        const response = await fetch(`${window.Shopify.routes.root}apps/aso-proxy/api/templates/${id}`, {
          method: 'GET',
          headers: {
            'Content-Type': 'application/json',
          },
        });
    
        if (!response.ok) {
          throw new Error(`ASO Proxy configuration fetch failed with status: ${response.status}`);
        }
    
        const data = await response.json();
        return data;
      } catch (error) {
        console.error('Error fetching ASO Proxy configuration:', error);
        // Handle the error appropriately in your application (e.g., display an error message to the user)
        return null; // Or throw an error if necemmmssuhhh ssscurrentConfig.data.settings.theme.skin
      }
  }

  var asoTemplateData = []




  document.addEventListener('DOMContentLoaded', function(){
      getAsotemplates().then(templates=>{
      const contentHtml ="";
      console.log("template dtata", templates)


      const templateDiv = document.querySelector('#aso_aso_shopify_id{{ aso_aso_shopify_id }} #asoTemplate');
      const templateItem = templateDiv.querySelector('#aso_aso_shopify_id{{ aso_aso_shopify_id }} .asoTemplateItem');

      const templateUl = document.querySelector('#aso_aso_shopify_id{{ aso_aso_shopify_id }} #asoTemplateUl');
      const templateLiItem = templateUl.querySelector('#aso_aso_shopify_id{{ aso_aso_shopify_id }} .asoTemplateLiItem'); 

      // Créer un nouveau div pour contenir les éléments clonés
      const newContainer = document.createElement('div');
      const newContainerUl = document.createElement('ul');

      const categories = []; 

  // Pour chaque élément dans templates
      templates?.filter(template=>(aso_configuration_id=="0" || template.configurationId==aso_configuration_id ) ).forEach(template => {
          // Cloner l'élément template
          if(!template.recaps){
            return false;
          }
          const clone = templateItem.cloneNode(true);
          if (templates?.length) {
            asoTemplateData.push(...templates)
          }

          if(template.category){
            if(!categories.find((curr)=> curr.id == template.categoryId)){
              categories.push(template.category)
            };
          } 
          // Mettre à jour le contenu
          if (template.prevImg){
              clone.querySelector('.asoTemplateItemImg').setAttribute('src',template.prevImg)
              clone.querySelector('.asoTemplateItemRealImg').setAttribute('src',template.realImg||template.prevImg)
          }
          clone.setAttribute("data-id", template.categoryId)
          clone.setAttribute('id',"asoTemplateItem"+template.id);
          clone.querySelector('.asoTemplateItemName').textContent = template.name;
          clone.querySelector('.asoTemplateItemSize').textContent = template.recaps.size;
          clone.querySelector('.asoTemplateItemPrice').textContent = (template.basePrice + template.recaps.customPrice).toFixed(2);
          clone.querySelector('.asoTemplateItemTextAfter').textContent = template.recaps.priceType;
          const asoDesignPageUrl =  clone.querySelector('.asoTemplateItemCustomize').getAttribute('href');
          clone.querySelector('.asoTemplateItemCustomize').setAttribute("href", asoDesignPageUrl+(asoDesignPageUrl.includes("?")?"&":"?")+"aso-template-id="+template.id+"&aso-config-id=" +template.configurationId)
          clone.querySelector('.asoTemplateItemAddToCart').setAttribute('onclick',"addTemplateTocart("+template.id+")");
          clone.querySelector('.notAddingTocart').setAttribute('class',"notAddingTocart"+template.id);
          clone.querySelector('.addingTocart').setAttribute('class',"addingTocart"+template.id);
          if (template?.enableAddToCart) {
              clone.querySelector('.asoTemplateItemAddToCart').style.display = 'none';
          }

          
          newContainer.appendChild(clone);
      });

      if(templates?.length){
        templateLiItem.setAttribute("id","asoTemplateCategoryAll")
        newContainerUl.appendChild(templateLiItem);
      }

    categories?.forEach((category)=>{
        const clone = templateLiItem.cloneNode(true);
        clone.setAttribute("data-id", category.id);
        clone.setAttribute("class"," asoTemplateLi asoTemplateLiItem")
        clone.innerHTML = category.name;
        newContainerUl.appendChild(clone);
      });

      // Remplacer le contenu de #asoTemplate par le nouveau contenu
      document.querySelector('#aso_aso_shopify_id{{ aso_aso_shopify_id }} #aso-templates-loader').style.display = 'none'; 
      if(!newContainer.innerHTML){
        document.querySelector('#aso_aso_shopify_id{{ aso_aso_shopify_id }} .not-found-wrapper').style.display = 'flex'; 
      }
      templateDiv.innerHTML = newContainer.innerHTML;
      templateUl.innerHTML = newContainerUl.innerHTML; 

      // Ouvrir le configurateur : au clic sur Customize, loader 3 sec puis ouvrir la modal (pas de rechargement)
      var asoContainer = document.querySelector('#aso_aso_shopify_id{{ aso_aso_shopify_id }}');
      var DESIGN_CUSTOMIZE_DELAY_MS = 3000;
      if (asoContainer && !asoContainer.hasAttribute('data-aso-customize-bound') && typeof asoTemplateUseModal !== 'undefined' && asoTemplateUseModal) {
        asoContainer.setAttribute('data-aso-customize-bound', '1');
        asoContainer.addEventListener('click', function(ev) {
          var customizeLink = ev.target.closest('.asoTemplateItemCustomize');
          if (!customizeLink) return;
          if (customizeLink.classList.contains('aso-customize-loading')) return;
          var designModal = document.getElementById('aso-design-modal');
          if (!designModal) return;
          try {
            var linkUrl = new URL(customizeLink.href, window.location.origin);
            if (linkUrl.pathname === window.location.pathname) {
              ev.preventDefault();
              ev.stopPropagation();
              history.replaceState(null, '', linkUrl.pathname + linkUrl.search);
              customizeLink.classList.add('aso-customize-loading');
              customizeLink.style.pointerEvents = 'none';
              if (typeof lockProductForm === 'function') lockProductForm(true);
              setTimeout(function() {
                customizeLink.classList.remove('aso-customize-loading');
                customizeLink.style.pointerEvents = '';
                if (window.asoUseIframe === true) {
                  if (typeof openDesignModal === 'function') openDesignModal();
                } else {
                  window.dispatchEvent(new CustomEvent('aso-reload-configurator'));
                  if (typeof openDesignModal === 'function') openDesignModal();
                }
              }, DESIGN_CUSTOMIZE_DELAY_MS);
            }
          } catch (err) { }
        });
      }

    
  }).catch((error) =>{
    document.querySelector('#aso_aso_shopify_id{{ aso_aso_shopify_id }} #aso-templates-loader').style.display = 'none';
    document.querySelector('#aso_aso_shopify_id{{ aso_aso_shopify_id }} .not-found-wrapper').style.display = 'flex'; 
    console.log(' error  on fetching ')
  });
  }); 



 async function addTemplateTocart(id){
    console.log("start  add to  cart");
    if (typeof addTemplateToCartShopify == "function") {
      //debut de gestion du loading
      let template = await getAsoTemplate(id);
      const templateDiv = document.querySelector('#aso_aso_shopify_id{{ aso_aso_shopify_id }} #asoTemplate');
      templateDiv.querySelector('.notAddingTocart'+template.id).style.display = 'none';
      templateDiv.querySelector('.addingTocart'+template.id).style.display = 'block';
    
      //fin

      addTemplateToCartShopify(template).then(res=>{
        //debut de gestion du loading
        templateDiv.querySelector('.notAddingTocart'+template.id).style.display = 'block';
        templateDiv.querySelector('.addingTocart'+template.id).style.display = 'none';
        //fin
        console.log("end of  add to  cart",res);
      }).catch((err)=>{
        console.log("error on adding to cart", error);
      });
    }
  }


  function toggleActive(element) {
    // Check if the clicked element is already active
    var isActive = element.classList.contains('aso-active');

    // Remove the active class from all list items
    var items = element.closest('.aso_aso_shopify').querySelectorAll('.aso-categories li');

    items.forEach(function(item) {
        item.classList.remove('aso-active');
    });

    // Hide all content items
    var contentItems = element.closest('.aso_aso_shopify').querySelectorAll('.asoTemplateItem');
   
    contentItems.forEach(function(contentItem) {
        contentItem.classList.add('hidden');
    });

    // If the clicked element was not active, activate it and show corresponding content

        element.classList.add('aso-active');

        // Get the data-id attribute of the clicked element
        var id = element.getAttribute('data-id');

        // Show the content items with the same data-id
        if(id==""|| id == null){
          contentItems.forEach(function(contentItem) {
                contentItem.classList.remove('hidden');
          });
        }else{
          contentItems.forEach(function(contentItem) {
              if (contentItem.getAttribute('data-id') === id) {
                  contentItem.classList.remove('hidden');
              }
          });
        };
    

    // Log the active category ID to the console
    var element_id = element.getAttribute('data-id');
  }
</script>

