  <div class="aso-modal-buttons-container aso-templates-modal-buttons">
    <button id="asoOpenTemplatesModalBtn" type="button" class="aso-modal-button aso-templates-modal-button"
            style="background-color: {{ block.settings.templates_modal_button_color }}; color: {{ block.settings.templates_modal_button_text_color }};">
      {{ block.settings.templates_modal_button_text }}
    </button>
  </div>

