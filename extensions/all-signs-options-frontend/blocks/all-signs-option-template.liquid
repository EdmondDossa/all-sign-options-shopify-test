{% assign aso_design_page_url = block.settings.asoDesignPageUrl %}
{% if product %}{% assign aso_design_page_url = product.url %}{% endif %}

{% if block.settings.use_modal_interface %}
  <div class="aso-template-block-modal-wrapper">
    <button type="button" id="aso-open-template-list-modal-{{ block.id }}" class="aso-modal-button aso-template-list-button" style="background-color: {{ block.settings.template_modal_button_color | default: '#febd52' }}; color: {{ block.settings.template_modal_button_text_color | default: '#ffffff' }};">
      {{ block.settings.template_modal_button_text | default: "View templates" }}
    </button>
    <div id="aso-template-list-modal-{{ block.id }}" class="aso-modal" style="display: none;">
      <div class="aso-modal-content">
        <div class="aso-modal-header">
          <h2>{{ block.settings.template_modal_button_text | default: "View templates" }}</h2>
          <button type="button" class="aso-modal-close" onclick="closeAsoTemplateListModal{{ block.id | replace: '-', '_' }}()">&times;</button>
        </div>
        <div class="aso-modal-body">
          {% render 'template-list',
            aso_template_id: block.id,
            text_all: block.settings.text_all,
            text_template_not_found: block.settings.text_template_not_found,
            text_add_to_cart: block.settings.text_add_to_cart,
            text_customize: block.settings.text_customize,
            aso_configuration_id: block.settings.aso_configuration_id,
            aso_design_page_url: aso_design_page_url,
            colour_bg_add_to_cart: block.settings.colour_bg_add_to_cart,
            colour_bg_customize: block.settings.colour_bg_customize,
            colour_text_add_to_cart: block.settings.colour_text_add_to_cart,
            colour_text_customize: block.settings.colour_text_customize
          %}
        </div>
      </div>
    </div>
  </div>
  <script>
    (function() {
      function openAsoTemplateListModal{{ block.id | replace: '-', '_' }}() {
        var modal = document.getElementById('aso-template-list-modal-{{ block.id }}');
        if (modal) { modal.style.display = 'block'; document.body.style.overflow = 'hidden'; document.body.classList.add('aso-modal-open'); }
      }
      window.closeAsoTemplateListModal{{ block.id | replace: '-', '_' }} = function() {
        var modal = document.getElementById('aso-template-list-modal-{{ block.id }}');
        if (modal) { modal.style.display = 'none'; document.body.style.overflow = 'auto'; document.body.classList.remove('aso-modal-open'); }
        if (typeof lockProductForm === 'function') lockProductForm(false);
      };
      document.addEventListener('DOMContentLoaded', function() {
        var btn = document.getElementById('aso-open-template-list-modal-{{ block.id }}');
        var modal = document.getElementById('aso-template-list-modal-{{ block.id }}');
        if (btn) btn.addEventListener('click', function(e) { e.preventDefault(); if (typeof lockProductForm === 'function') lockProductForm(true); openAsoTemplateListModal{{ block.id | replace: '-', '_' }}(); });
        if (modal) {
          modal.addEventListener('click', function(ev) { if (ev.target === modal) window.closeAsoTemplateListModal{{ block.id | replace: '-', '_' }}(); });
          modal.remove();
          document.body.appendChild(modal);
        }
      });
    })();
  </script>
{% else %}
  {% render 'template-list',
    aso_template_id: block.id,
    text_all: block.settings.text_all,
    text_template_not_found: block.settings.text_template_not_found,
    text_add_to_cart: block.settings.text_add_to_cart,
    text_customize: block.settings.text_customize,
    aso_configuration_id: block.settings.aso_configuration_id,
    aso_design_page_url: aso_design_page_url,
    colour_bg_add_to_cart: block.settings.colour_bg_add_to_cart,
    colour_bg_customize: block.settings.colour_bg_customize,
    colour_text_add_to_cart: block.settings.colour_text_add_to_cart,
    colour_text_customize: block.settings.colour_text_customize
  %}
{% endif %}

{% schema %}
{
  "name": "ASO templates list",
  "target": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "use_modal_interface",
      "label": "Use modal interface",
      "default": true,
      "info": "When enabled, a button is shown. Clicking it opens a modal with the template list inside."
    },
    {
      "type": "header",
      "content": "Modal button (when modal interface is enabled)"
    },
    {
      "type": "text",
      "id": "template_modal_button_text",
      "label": "Button text",
      "default": "View templates"
    },
    {
      "type": "color",
      "id": "template_modal_button_color",
      "label": "Button background color",
      "default": "#febd52"
    },
    {
      "type": "color",
      "id": "template_modal_button_text_color",
      "label": "Button text color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Template list settings"
    },
    {
      "type": "number",
      "id": "aso_configuration_id",
      "label": "Id of template's configuration",
      "default": 0
    },
    {
      "type": "url",
      "id": "asoDesignPageUrl",
      "label": "Design Screen page url",
      "default": "/"
    },
    { "type": "text", "id": "text_all", "label": "All template text", "default": "All templates" },
    { "type": "text", "id": "text_template_not_found", "label": "Template not available Text", "default": "No design template is available" },
    { "type": "text", "id": "text_add_to_cart", "label": "Add to cart text", "default": "Add to cart" },
    { "type": "text", "id": "text_customize", "label": "Customize text", "default": "Customize" },
    {
      "type": "color",
      "id": "colour_bg_add_to_cart",
      "label": "Add to cart background color",
      "default": "#122f81"
    },
    {
      "type": "color",
      "id": "colour_bg_customize",
      "label": "Customize background color",
      "default": "#febd52"
    },
    {
      "type": "color",
      "id": "colour_text_add_to_cart",
      "label": "Add to cart text color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "colour_text_customize",
      "label": "Customize text color",
      "default": "#FFFFFF"
    }
  ]
}
{% endschema %}
