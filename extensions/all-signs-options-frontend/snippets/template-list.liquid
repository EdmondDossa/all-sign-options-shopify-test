{% comment %}
  Snippet: template-list
  Renders the ASO template grid (categories + template items).
  Parameters: aso_template_id (required), text_all, text_template_not_found, text_add_to_cart, text_customize,
  aso_configuration_id, aso_design_page_url, colour_bg_add_to_cart, colour_bg_customize, colour_text_add_to_cart, colour_text_customize
{% endcomment %}
{% assign aso_template_id = aso_template_id | default: 'default' %}
{% assign text_all = text_all | default: 'All templates' %}
{% assign text_template_not_found = text_template_not_found | default: 'No design template is available' %}
{% assign text_add_to_cart = text_add_to_cart | default: 'Add to cart' %}
{% assign text_customize = text_customize | default: 'Customize' %}
{% assign aso_configuration_id_val = aso_configuration_id | default: 0 %}
{% assign aso_design_page_url = aso_design_page_url | default: '/' %}
{% assign colour_bg_add_to_cart = colour_bg_add_to_cart | default: '#122f81' %}
{% assign colour_bg_customize = colour_bg_customize | default: '#febd52' %}
{% assign colour_text_add_to_cart = colour_text_add_to_cart | default: '#FFFFFF' %}
{% assign colour_text_customize = colour_text_customize | default: '#FFFFFF' %}

<div id="aso_aso_shopify_id_{{ aso_template_id }}" class="aso_aso_shopify aso-template-list-snippet" style="min-height: 200px; margin-bottom: 2rem;">
    <div id="asoTemplateCategories">
      <ul class="aso-categories" id="asoTemplateUl">
        <li id="asoTemplateCategory" class="asoTemplateLi asoTemplateLiItem aso-active" data-id="" onclick="asoToggleActive_{{ aso_template_id }}(this)">{{ text_all }}</li>
      </ul>
    </div>
    <div id="asoTemplate" class="aso-template-container">
        <div class="asoTemplateItem" id="asoTemplateItemModel">
            <div class="aso-template-image-container">
                <div class="aso-template-image-wrapper">
                  <img class="asoTemplateItemImg" src="{{ 'img_rectangle_noir.png' | asset_url }}" alt="aso template">
                  <img class="asoTemplateItemRealImg" src="{{ 'img_rectangle_noir.png' | asset_url }}" alt="aso template">
                </div>
            </div>
            <div class="aso-template-details-container">
                <h5 class="asoTemplateItemName">template name</h5>
                <div class="aso-template-size asoTemplateItemSize">template size</div>
                <div><span class="asoTemplateItemPrice">Price</span> <span class="asoTemplateItemTextAfter">after price</span></div>
                <div class="asoTemplateItemBtnWrapper">
                    <button class="asoTemplateItemAddToCart">
                      <svg class="notAddingTocart" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" height="12" width="12">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 0 0-3 3h15.75m-12.75-3h11.218c1.121-2.3 2.1-4.684 2.924-7.138a60.114 60.114 0 0 0-16.536-1.84M7.5 14.25 5.106 5.272M6 20.25a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Zm12.75 0a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Z" />
                      </svg>
                      <svg class="addingTocart" style="display: none;" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100" preserveAspectRatio="xMidYMid" height="12" width="12">
                          <circle cx="50" cy="50" r="32" stroke-width="8" stroke="currentColor" stroke-dasharray="50.26548245743669 50.26548245743669" fill="none" stroke-linecap="round">
                          <animateTransform attributeName="transform" type="rotate" repeatCount="indefinite" dur="1s" keyTimes="0;1" values="0 50 50;360 50 50"></animateTransform>
                          </circle>
                      </svg>
                      <span>{{ text_add_to_cart }}</span>
                    </button>
                    <a href="{{ aso_design_page_url }}" class="asoTemplateItemCustomize">
                      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" height="12" width="12">
                            <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L6.832 19.82a4.5 4.5 0 0 1-1.897 1.13l-2.685.8.8-2.685a4.5 4.5 0 0 1 1.13-1.897L16.863 4.487Zm0 0L19.5 7.125" />
                        </svg>
                        <span>{{ text_customize }}</span>
                    </a>
                </div>
            </div>
        </div>
    </div>
    <div id="aso-templates-loader">
      <div class="aso-grid-container">
          <div style="display: flex; flex-direction: column; height: 100%;">
              <div class="aso-loader-container" style="background: linear-gradient(to right, #a1a1a1, #e4e4e7, #a1a1a1); width: 100%; height: 100%;"></div>
          </div>
          <div style="display: flex; flex-direction: column; height: 100%;">
              <div class="aso-loader-container" style="background: linear-gradient(to right, #a1a1a1, #e4e4e7, #a1a1a1);width: 100%;height: 100%;"></div>
          </div>
          <div style="display: flex; flex-direction: column; height: 100%;">
              <div class="aso-loader-container" style="background: linear-gradient(to right, #a1a1a1, #e4e4e7, #a1a1a1); width: 100%; height: 100%;"></div>
          </div>
      </div>
    </div>
    <div class="not-found-wrapper" style="display:none;">
        <div class="centered-message">{{ text_template_not_found }}</div>
    </div>
</div>

<script>
  (function() {
    var asoTemplateId = "{{ aso_template_id | replace: '"', '' }}";
    var aso_configuration_id = "{{ aso_configuration_id_val }}";
    var containerSelector = '#aso_aso_shopify_id_' + asoTemplateId;

    if (typeof addTemplateToCartShopify === 'undefined') {
      if (typeof asoConfigurationId === 'undefined') { var asoConfigurationId = ""; }
      if (typeof asoProductId === 'undefined') { var asoProductId = ""; }
      var asoCurrency = "{{ cart.currency.symbol }}";
      var asoPriceFormat = "{{ shop.money_format }}";
      var asoRegularPrice = "";
      var asoFormattedPrice = "{{ 123456 | money_without_currency }}";
      var asoCurrency_pos = asoPriceFormat[0] == asoCurrency ? "left" : "right";
      var asoThousandSep = asoFormattedPrice[1]=="2" ? "" : asoFormattedPrice[1];
      var asoDecimalSep = asoFormattedPrice[4]=="5" ? "." : asoFormattedPrice[4];
      var asoCartUrl = "{{ routes.cart_url }}";
      document.write('<script src="{{ "shopify.js" | asset_url }}"><\/script>');
    }

    async function getAsotemplatesSnippet() {
      try {
        const response = await fetch((window.Shopify?.routes?.root || '/') + 'apps/aso-proxy/api/templates', {
          method: 'GET',
          headers: { 'Content-Type': 'application/json' },
        });
        if (!response.ok) throw new Error('Fetch failed');
        return await response.json();
      } catch (error) {
        console.error('Error fetching ASO templates:', error);
        return null;
      }
    }

    async function getAsoTemplateSnippet(id) {
      try {
        const response = await fetch((window.Shopify?.routes?.root || '/') + 'apps/aso-proxy/api/templates/' + id, {
          method: 'GET',
          headers: { 'Content-Type': 'application/json' },
        });
        if (!response.ok) throw new Error('Fetch failed');
        return await response.json();
      } catch (error) {
        console.error('Error fetching ASO template:', error);
        return null;
      }
    }

    window['asoToggleActive_' + asoTemplateId] = function(element) {
      var items = element.closest('.aso_aso_shopify').querySelectorAll('.aso-categories li');
      items.forEach(function(item) { item.classList.remove('aso-active'); });
      var contentItems = element.closest('.aso_aso_shopify').querySelectorAll('.asoTemplateItem');
      contentItems.forEach(function(contentItem) { contentItem.classList.add('hidden'); });
      element.classList.add('aso-active');
      var id = element.getAttribute('data-id');
      contentItems.forEach(function(contentItem) {
        if (id == "" || id == null || contentItem.getAttribute('data-id') === id) {
          contentItem.classList.remove('hidden');
        }
      });
    };

    window['addTemplateTocartSnippet_' + asoTemplateId] = async function(id) {
      if (typeof addTemplateToCartShopify !== 'function') return;
      var template = await getAsoTemplateSnippet(id);
      if (!template) return;
      var templateDiv = document.querySelector(containerSelector + ' #asoTemplate');
      if (templateDiv) {
        var notAdding = templateDiv.querySelector('.notAddingTocart' + template.id);
        var adding = templateDiv.querySelector('.addingTocart' + template.id);
        if (notAdding) notAdding.style.display = 'none';
        if (adding) adding.style.display = 'block';
      }
      addTemplateToCartShopify(template).then(function() {
        if (templateDiv) {
          var n = templateDiv.querySelector('.notAddingTocart' + template.id);
          var a = templateDiv.querySelector('.addingTocart' + template.id);
          if (n) n.style.display = 'block';
          if (a) a.style.display = 'none';
        }
      }).catch(function() {
        if (templateDiv) {
          var n = templateDiv.querySelector('.notAddingTocart' + template.id);
          var a = templateDiv.querySelector('.addingTocart' + template.id);
          if (n) n.style.display = 'block';
          if (a) a.style.display = 'none';
        }
      });
    };

    function initTemplateList() {
      var container = document.querySelector(containerSelector);
      if (!container) return;

      getAsotemplatesSnippet().then(function(templates) {
        var templateDiv = container.querySelector('#asoTemplate');
        var templateItem = templateDiv ? templateDiv.querySelector('.asoTemplateItem') : null;
        var templateUl = container.querySelector('#asoTemplateUl');
        var templateLiItem = templateUl ? templateUl.querySelector('.asoTemplateLiItem') : null;
        if (!templateDiv || !templateItem || !templateUl || !templateLiItem) return;

        var newContainer = document.createElement('div');
        var newContainerUl = document.createElement('ul');
        var categories = [];

        templates = templates || [];
        templates.filter(function(t) { return aso_configuration_id == "0" || t.configurationId == aso_configuration_id; }).forEach(function(template) {
          if (!template.recaps) return;
          var clone = templateItem.cloneNode(true);
          if (template.prevImg) {
            var img = clone.querySelector('.asoTemplateItemImg');
            var realImg = clone.querySelector('.asoTemplateItemRealImg');
            if (img) img.setAttribute('src', template.prevImg);
            if (realImg) realImg.setAttribute('src', template.realImg || template.prevImg);
          }
          clone.setAttribute('data-id', template.categoryId || '');
          clone.setAttribute('id', 'asoTemplateItem' + template.id);
          clone.querySelector('.asoTemplateItemName').textContent = template.name;
          clone.querySelector('.asoTemplateItemSize').textContent = template.recaps.size;
          clone.querySelector('.asoTemplateItemPrice').textContent = (template.basePrice + template.recaps.customPrice).toFixed(2);
          clone.querySelector('.asoTemplateItemTextAfter').textContent = template.recaps.priceType || '';
          var designUrl = clone.querySelector('.asoTemplateItemCustomize').getAttribute('href');
          clone.querySelector('.asoTemplateItemCustomize').setAttribute('href', designUrl + (designUrl.indexOf('?') >= 0 ? '&' : '?') + 'aso-template-id=' + template.id + '&aso-config-id=' + template.configurationId);
          clone.querySelector('.asoTemplateItemAddToCart').setAttribute('onclick', 'addTemplateTocartSnippet_' + asoTemplateId + '(' + template.id + ')');
          var notAdding = clone.querySelector('.notAddingTocart');
          var adding = clone.querySelector('.addingTocart');
          if (notAdding) notAdding.setAttribute('class', 'notAddingTocart' + template.id);
          if (adding) adding.setAttribute('class', 'addingTocart' + template.id);
          if (template.enableAddToCart) {
            var btn = clone.querySelector('.asoTemplateItemAddToCart');
            if (btn) btn.style.display = 'none';
          }
          if (template.category && !categories.find(function(c) { return c.id == template.categoryId; })) {
            categories.push(template.category);
          }
          newContainer.appendChild(clone);
        });

        if (templates.length) {
          templateLiItem.setAttribute('id', 'asoTemplateCategoryAll');
          newContainerUl.appendChild(templateLiItem);
        }
        categories.forEach(function(category) {
          var clone = templateLiItem.cloneNode(true);
          clone.setAttribute('data-id', category.id);
          clone.setAttribute('class', 'asoTemplateLi asoTemplateLiItem');
          clone.innerHTML = category.name;
          clone.onclick = function() { window['asoToggleActive_' + asoTemplateId](this); };
          newContainerUl.appendChild(clone);
        });

        templateDiv.innerHTML = newContainer.innerHTML;
        templateUl.innerHTML = newContainerUl.innerHTML;

        container.querySelector('#aso-templates-loader').style.display = 'none';
        if (!newContainer.innerHTML) {
          container.querySelector('.not-found-wrapper').style.display = 'flex';
        }

        container.querySelectorAll('.aso-categories li').forEach(function(li) {
          li.onclick = function() { window['asoToggleActive_' + asoTemplateId](this); };
        });

        container.querySelectorAll('.asoTemplateItemCustomize').forEach(function(link) {
          link.addEventListener('click', function(ev) {
            var designModal = document.getElementById('aso-design-modal');
            if (!designModal) return;
            try {
              var linkUrl = new URL(link.href, window.location.origin);
              if (linkUrl.pathname === window.location.pathname) {
                ev.preventDefault();
                ev.stopPropagation();
                history.replaceState(null, '', linkUrl.pathname + linkUrl.search);
                if (typeof lockProductForm === 'function') lockProductForm(true);
                if (typeof openDesignModal === 'function') openDesignModal();
              }
            } catch (err) {}
          });
        });
      }).catch(function() {
        container.querySelector('#aso-templates-loader').style.display = 'none';
        container.querySelector('.not-found-wrapper').style.display = 'flex';
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initTemplateList);
    } else {
      initTemplateList();
    }
  })();
</script>

<style>
  .aso-template-list-snippet #asoTemplateItemModel { display: none !important; }
  .aso-template-list-snippet #asoTemplateCategory { display: none !important; }
  .aso-template-list-snippet .asoTemplateItemCustomize {
    color: {{ colour_text_customize }};
    display: flex; justify-content: center; align-items: center;
    background-color: {{ colour_bg_customize }};
    border-radius: 0.5rem; width: 100%; padding: 0.75rem;
    text-decoration: none; gap: 8px; font-size: 1.5rem;
  }
  .aso-template-list-snippet .asoTemplateItemCustomize:hover { background-color: #fcac29; }
  .aso-template-list-snippet .asoTemplateItemAddToCart {
    color: {{ colour_text_add_to_cart }};
    display: flex; justify-content: center; align-items: center;
    background-color: {{ colour_bg_add_to_cart }};
    border-color: {{ colour_bg_add_to_cart }};
    border-radius: 5px; width: 100%; padding: 0.75rem;
    text-decoration: none; gap: 8px; font-size: 1.5rem; cursor: pointer;
  }
  .aso-template-list-snippet .asoTemplateItemBtnWrapper { gap: 1rem; padding-block: 1rem; display: flex; flex-direction: column; }
  .aso-template-list-snippet .asoTemplateItemPrice { font-weight: bold; }
  .aso-template-list-snippet .asoTemplateItemName { font-weight: bold; margin-block-end: 1rem; }
  .aso-template-list-snippet .aso-template-details-container { border: 1px solid #c3cfd6; border-left: 0; border-bottom: 0; border-right: 0; padding: 1rem; }
  .aso-template-list-snippet .asoTemplateItemImg, .aso-template-list-snippet .asoTemplateItemRealImg { height: 100%; width: 100%; object-fit: cover; }
  .aso-template-list-snippet .aso-template-image-wrapper { width: 100%; height: 100%; display: flex; justify-content: center; align-items: center; overflow: clip; padding: 0; position: relative; }
  .aso-template-list-snippet .aso-template-image-container { display: flex; justify-content: center; align-items: center; height: 200px; overflow: hidden; }
  .aso-template-list-snippet .asoTemplateItem { border: 1px solid #c3cfd6; border-radius: 5px; overflow: hidden; }
  .aso-template-list-snippet .aso-template-container { display: grid; gap: 20px; }
  @media (min-width: 1200px) { .aso-template-list-snippet .aso-template-container { grid-template-columns: repeat(4, 1fr); } }
  @media (min-width: 992px) and (max-width: 1199px) { .aso-template-list-snippet .aso-template-container { grid-template-columns: repeat(4, 1fr); } }
  @media (min-width: 600px) and (max-width: 991px) { .aso-template-list-snippet .aso-template-container { grid-template-columns: repeat(3, 1fr); } .aso-template-list-snippet .aso-template-image-container { height: 150px; } }
  @media (max-width: 600px) { .aso-template-list-snippet .aso-template-container { grid-template-columns: repeat(2, 1fr); } .aso-template-list-snippet .aso-template-image-container { height: 150px; } }
  @media (max-width: 400px) { .aso-template-list-snippet .aso-template-container { grid-template-columns: 1fr; } }
  .aso-template-list-snippet .aso-categories { list-style: none; gap: 8px; flex-wrap: wrap; padding: 0; margin: 2rem; display: flex; justify-content: center; }
  .aso-template-list-snippet .aso-categories li { border-bottom: 1px solid lightslategray; padding: 4px 15px; margin-right: 10px; color: lightslategray; font-weight: 600; transition: background-color 0.3s, color 0.3s; }
  .aso-template-list-snippet .aso-categories li.aso-active { background-color: lightslategray; color: white; }
  .aso-template-list-snippet #aso-templates-loader { height: 50vh; width: 100%; }
  .aso-template-list-snippet .aso-grid-container { grid-gap: 10px; display: grid; grid-template-columns: repeat(3, 1fr); height: 100%; padding: 10px; width: 100%; }
  @keyframes asoPulseGradient { 0%, 100% { background-size: 200% 100%; background-position: 200% 50%; opacity: 0.5; } 50% { background-size: 200% 100%; background-position: -100% 50%; opacity: 1; } }
  .aso-template-list-snippet #aso-templates-loader .aso-loader-container { animation: asoPulseGradient 1.5s ease infinite; }
  .aso-template-list-snippet .centered-message { padding: 20px; color: darkslategray; border-radius: 8px; text-align: center; font-size: 25px; }
  .aso-template-list-snippet .not-found-wrapper { height: 250px; width: 100%; margin: 20px 0; display: flex; justify-content: center; align-items: center; border: 1px solid lightgray; border-radius: 2px; }
  .aso-template-list-snippet .asoTemplateItemRealImg { position: absolute; top: 0; left: 0; opacity: 0; transition: opacity 0.6s; }
  .aso-template-list-snippet .aso-template-image-wrapper:hover .asoTemplateItemImg { opacity: 0; }
  .aso-template-list-snippet .aso-template-image-wrapper:hover .asoTemplateItemRealImg { opacity: 1; }
</style>
