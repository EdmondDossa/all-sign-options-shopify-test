<div class="bg-loader">
  <div id="aso-configurator-loader" class="aso-loader-shell" aria-hidden="true">
    <div class="aso-loader-backdrop"></div>

    <div class="aso-loader-frame">
      <div class="aso-loader-header">
        <div class="aso-loader-brand">
          <div class="aso-loader-brand-dot"></div>
          <div class="aso-loader-brand-copy">
            <span class="aso-loader-eyebrow">Customizer</span>
            <strong>Preparing your design studio</strong>
          </div>
        </div>
        <div class="aso-loader-status">
          <span class="aso-loader-status-pulse"></span>
          Loading assets
        </div>
      </div>

      <div class="aso-loader-progress">
        <div class="aso-loader-progress-bar"></div>
      </div>

      <div class="aso-loader-layout">
        <aside class="aso-loader-sidebar">
          <div class="aso-loader-block aso-loader-block-title"></div>
          <div class="aso-loader-stack">
            <div class="aso-loader-chip"></div>
            <div class="aso-loader-chip"></div>
            <div class="aso-loader-chip"></div>
            <div class="aso-loader-chip aso-loader-chip-short"></div>
          </div>
          <div class="aso-loader-stack aso-loader-stack-bottom">
            <div class="aso-loader-line"></div>
            <div class="aso-loader-line aso-loader-line-short"></div>
          </div>
        </aside>

        <main class="aso-loader-canvas">
          <div class="aso-loader-canvas-glow"></div>
          <div class="aso-loader-canvas-card">
            <div class="aso-loader-canvas-stage">
              <div class="aso-loader-preview-ring"></div>
              <div class="aso-loader-preview-card"></div>
            </div>

            <div class="aso-loader-toolbar">
              <div class="aso-loader-tool"></div>
              <div class="aso-loader-tool"></div>
              <div class="aso-loader-tool"></div>
              <div class="aso-loader-tool"></div>
              <div class="aso-loader-tool"></div>
            </div>
          </div>
        </main>

        <aside class="aso-loader-panel">
          <div class="aso-loader-block aso-loader-block-panel"></div>
          <div class="aso-loader-panel-card">
            <div class="aso-loader-line"></div>
            <div class="aso-loader-line aso-loader-line-short"></div>
          </div>
          <div class="aso-loader-panel-card">
            <div class="aso-loader-line"></div>
            <div class="aso-loader-line aso-loader-line-short"></div>
          </div>
        </aside>
      </div>
    </div>
  </div>
</div>
